# Copy this file to .env and fill only the values needed for local runs.
# Do not commit real API keys.

FRED_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=

# Optional local Ollama configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma:7b

NEWS_TAVILY_ENABLED=false
NEWS_VECTORSTORE_ENABLED=true
NEWS_VECTORSTORE_PERSIST_DIR=data/vectorstore/chroma_news

NEWS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
NEWS_EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEWS_EMBEDDING_LOCAL_FILES_ONLY=true

TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=news
TAVILY_DAYS=30
TAVILY_RECENT_PRIORITY_DAYS=7
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_RAW_CONTENT=false

NEWS_RETRIEVAL_TOP_K=5
NEWS_MIN_QUALITY_SCORE=0.60
NEWS_LOW_QUALITY_THRESHOLD=0.40
NEWS_REQUIRE_COMPANY_MATCH=true
NEWS_DEDUPLICATE=true

BACKTEST_ENABLED=false
BACKTEST_YFINANCE_ENABLED=false
